# Copy to .env and adjust. All vars are prefixed EIDOLON_ (pydantic-settings).

# --- SAGE substrate ---
# "memory"   = fast in-memory port (default, no node; non-persistent).
# "postgres" = persistent single box (docker compose); ledger is hash-chained.
# "sage"     = live BFT-consensus SDK (multi-node).
EIDOLON_SAGE_BACKEND=memory
EIDOLON_SAGE_BASE_URL=http://localhost:8080
EIDOLON_SAGE_AGENT_KEY_PATH=~/.sage/agent.key
EIDOLON_SAGE_ATTESTATION_DOMAIN=attestations
# postgres port: max most-recent memories per principal loaded before ranking.
EIDOLON_SAGE_PG_RECALL_PREFETCH=5000

# --- single-VPS deployment (docker-compose.deploy.yml / `make deploy`) ---
# Set a strong DB password before deploying. EIDOLON_PORT is the host port.
EIDOLON_DB_PASSWORD=change-me
EIDOLON_PORT=8000

# --- operator auth (single tenant, two roles) ---
# admin  = full control plane (mint/revoke, approvals, resolve, capture…)
# auditor = read-only forensic surface (/audit, /replay).
# REQUIRED before exposing the service (fail-closed). Unset = OPEN, localhost dev
# only, warns loudly. Generate strong values, e.g. `openssl rand -hex 32`.
EIDOLON_ADMIN_TOKEN=
EIDOLON_AUDIT_TOKEN=
# Mark the session cookie Secure (HTTPS only). Set true behind the TLS proxy.
EIDOLON_SESSION_COOKIE_SECURE=false
# Optional Host allow-list (comma-separated) and Caddy auto-HTTPS domain.
EIDOLON_TRUSTED_HOSTS=
EIDOLON_DOMAIN=

# --- ETHOS style engine (Claude) ---
# Required only to render drafts/escalations. Judgment/authority never use it.
EIDOLON_ANTHROPIC_API_KEY=
EIDOLON_STYLE_MODEL=claude-sonnet-4-6
EIDOLON_STYLE_ENABLED=true

# --- Operational store ---
EIDOLON_DATABASE_URL=postgresql+psycopg://eidolon:eidolon@localhost:5432/eidolon

# --- KAIROS global autonomy dial (observe|draft|notify|autonomous) ---
EIDOLON_AUTONOMY_DIAL=autonomous

# --- THEMIS dead-man's-switch ---
EIDOLON_HEARTBEAT_TTL_SECONDS=3600
