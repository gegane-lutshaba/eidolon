# Copy to .env and adjust. All vars are prefixed EIDOLON_ (pydantic-settings).

# --- SAGE substrate ---
# "memory" = fast in-memory port (default, no node). "sage" = live SDK.
EIDOLON_SAGE_BACKEND=memory
EIDOLON_SAGE_BASE_URL=http://localhost:8080
EIDOLON_SAGE_AGENT_KEY_PATH=~/.sage/agent.key
EIDOLON_SAGE_ATTESTATION_DOMAIN=attestations

# --- ETHOS style engine (Claude) ---
# Required only to render drafts/escalations. Judgment/authority never use it.
EIDOLON_ANTHROPIC_API_KEY=
EIDOLON_STYLE_MODEL=claude-sonnet-4-6
EIDOLON_STYLE_ENABLED=true

# --- Operational store ---
EIDOLON_DATABASE_URL=postgresql+psycopg://eidolon:eidolon@localhost:5432/eidolon

# --- KAIROS global autonomy dial (observe|draft|notify|autonomous) ---
EIDOLON_AUTONOMY_DIAL=autonomous

# --- THEMIS dead-man's-switch ---
EIDOLON_HEARTBEAT_TTL_SECONDS=3600
