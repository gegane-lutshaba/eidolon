# Copy to .env and adjust. All vars are prefixed EIDOLON_ (pydantic-settings).

# --- SAGE substrate ---
# "memory"   = fast in-memory port (default, no node; non-persistent).
# "postgres" = persistent single box (docker compose); ledger is hash-chained.
# "sage"     = live BFT-consensus SDK (multi-node).
EIDOLON_SAGE_BACKEND=memory
EIDOLON_SAGE_BASE_URL=http://localhost:8080
EIDOLON_SAGE_AGENT_KEY_PATH=~/.sage/agent.key
EIDOLON_SAGE_ATTESTATION_DOMAIN=attestations
# postgres port: max most-recent memories per principal loaded before ranking.
EIDOLON_SAGE_PG_RECALL_PREFETCH=5000

# --- single-VPS deployment (docker-compose.deploy.yml / `make deploy`) ---
# Set a strong DB password before deploying. EIDOLON_PORT is the host port.
EIDOLON_DB_PASSWORD=change-me
EIDOLON_PORT=8000

# --- operator auth (single tenant, two roles) ---
# admin  = full control plane (mint/revoke, approvals, resolve, capture…)
# auditor = read-only forensic surface (/audit, /replay).
# REQUIRED before exposing the service (fail-closed). Unset = OPEN, localhost dev
# only, warns loudly. Generate strong values, e.g. `openssl rand -hex 32`.
EIDOLON_ADMIN_TOKEN=
EIDOLON_AUDIT_TOKEN=
# Mark the session cookie Secure (HTTPS only). Set true behind the TLS proxy.
EIDOLON_SESSION_COOKIE_SECURE=false
# Optional Host allow-list (comma-separated) and Caddy auto-HTTPS domain.
EIDOLON_TRUSTED_HOSTS=
EIDOLON_DOMAIN=

# --- SSO (OIDC, optional) ---
# Let staff sign in via your IdP (Google, Okta, Azure AD, Authentik…). Register
# <EIDOLON_PUBLIC_URL>/auth/sso/callback as the redirect URI with the IdP.
# Set all three to enable; leave blank for email/password only.
EIDOLON_OIDC_ISSUER=            # e.g. https://accounts.google.com or https://<tenant>.okta.com
EIDOLON_OIDC_CLIENT_ID=
EIDOLON_OIDC_CLIENT_SECRET=
EIDOLON_OIDC_SCOPES=openid email profile
# Restrict to these email domains (comma-separated). Empty = any verified email.
EIDOLON_OIDC_ALLOWED_DOMAINS=
# Put all SSO users in one shared team (so IT sees everyone's agents together).
# Leave blank to give each SSO user a personal org.
EIDOLON_OIDC_ORG_NAME=
EIDOLON_OIDC_BUTTON_LABEL=SSO

# --- public break-the-gate challenge ---
# true = /challenge needs no login: per-visitor isolated sessions (own
# in-memory ledger, never the real one), per-IP rate limit, idle auto-reset.
# Everything else stays token-gated. Pair with TRUST_PROXY_HEADERS behind a
# reverse proxy so rate limiting sees real client IPs.
EIDOLON_PUBLIC_CHALLENGE=false
EIDOLON_TRUST_PROXY_HEADERS=false

# --- mission control (live console + gateway reporting) ---
# Keys gateways use to report events (comma-separated; generate strong values).
# Gateways run: python -m eidolon.gateway --report-url https://your-host \
#   --report-key <one of these> --agent claude-code -- <downstream>
EIDOLON_GATEWAY_KEYS=
# Public base URL of this deployment (deep links in notifications).
EIDOLON_PUBLIC_URL=

# --- escalation push (optional; "your agent wants to X — approve?") ---
EIDOLON_TELEGRAM_BOT_TOKEN=
EIDOLON_TELEGRAM_CHAT_ID=
EIDOLON_SLACK_WEBHOOK_URL=

# --- ETHOS style engine (Claude) ---
# Required only to render drafts/escalations. Judgment/authority never use it.
EIDOLON_ANTHROPIC_API_KEY=
EIDOLON_STYLE_MODEL=claude-sonnet-4-6
EIDOLON_STYLE_ENABLED=true

# --- Operational store ---
EIDOLON_DATABASE_URL=postgresql+psycopg://eidolon:eidolon@localhost:5432/eidolon

# --- KAIROS global autonomy dial (observe|draft|notify|autonomous) ---
EIDOLON_AUTONOMY_DIAL=autonomous

# --- THEMIS dead-man's-switch ---
EIDOLON_HEARTBEAT_TTL_SECONDS=3600

# --- outbound email (optional; generic SMTP for notifications) ---
# Not required for password management: changing your password is self-service
# (sign in + current password), and there is no emailed reset flow.
EIDOLON_SMTP_HOST=
EIDOLON_SMTP_PORT=587
EIDOLON_SMTP_USER=
EIDOLON_SMTP_PASSWORD=
EIDOLON_SMTP_FROM=
EIDOLON_SMTP_TLS=true
